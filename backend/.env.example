# CordiaClassroom Backend — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# On Fly: fly secrets set NAME=value -a autostudy-ai

# AI: Groq when GROQ_API_KEY is set, otherwise OpenAI.
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional model overrides
# CLASSROOM_BUILD_MODEL=
# CLASSROOM_LIGHT_MODEL=
# CLASSROOM_VISION_MODEL=
# CLASSROOM_TUTOR_CONTEXT_TOKENS=
# STUDY_GUIDE_COST_SAVER=
# STUDY_GUIDE_COST_SAVER_MAX_CHARS=

# Supabase (project settings)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
# Legacy deployments may still provide SUPABASE_KEY; the backend accepts it as a fallback.

# Stripe (dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: otherwise the Stripe lookup keys are used
# STRIPE_PRO_MONTHLY_PRICE_ID=price_...
# STRIPE_PRO_SEMESTER_PRICE_ID=price_...

# Canvas access-token connect: base64 of 32 random bytes (openssl rand -base64 32). Set once; never rotate casually.
CANVAS_TOKEN_KEY=

# Signs written-quiz credit so it can't be forged (any long random string).
RETAIN_SIGNING_KEY=

# Deployment
ENVIRONMENT=production
FRONTEND_URL=https://classroom.cordiaai.io
# Comma-separated extension IDs allowed by CORS (development builds)
EXTENSION_IDS=

# Feature flags and allowlists
LEARNING_STYLES_ENABLED=true
# Comma-separated Supabase user UUIDs
UNLIMITED_USER_IDS=
FEEDBACK_REVIEWER_USER_IDS=
