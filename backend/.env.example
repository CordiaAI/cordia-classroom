# CordiaClassroom Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# OpenAI
OPENAI_API_KEY=sk-proj-...

# Supabase (get from your Supabase project settings)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
# Legacy deployments may still provide SUPABASE_KEY; the backend accepts it as a fallback.

# Stripe (get from dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CLASSROOM_PLUS_MONTHLY_PRICE_ID=price_...
STRIPE_CLASSROOM_PLUS_YEARLY_PRICE_ID=price_...

# Make.com Sign up Workflow (Only takes Name, Email, University, and Major)
MAKE_WEBHOOK_URL=https://hook.make.com/
MAKE_API_KEY=your-key

# Deployment
ENVIRONMENT=production
FRONTEND_URL=https://your-vercel-app.vercel.app
SITE_URL=https://classroom.cordiaai.io

# Comma-separated Supabase user UUIDs allowed to review beta feedback.
FEEDBACK_REVIEWER_USER_IDS=
