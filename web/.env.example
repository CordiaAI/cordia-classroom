# Web app (Next.js on Vercel). Copy to .env.local for local work. Never commit real values.
# NEXT_PUBLIC_* values reach the browser; everything else stays on the server.

# Backend (FastAPI on Fly) and Supabase
NEXT_PUBLIC_API_URL=https://autostudy-ai.fly.dev
CLASSROOM_API_URL=
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by the app's own API routes; never by the MCP server (/mcp).
SUPABASE_SERVICE_ROLE_KEY=

# AI (see CLAUDE.md for which model does what)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GROQ_API_KEY=
GROQ_CHAT_MODEL=
GROQ_TRANSCRIBE_MODEL=
OPENAI_API_KEY=
CLASSROOM_LECTURE_CHAT_MODEL=
CLASSROOM_TRANSCRIBE_MODEL=

# Visuals (Napkin)
NAPKIN_API_KEY=
NAPKIN_API_BASE=
NAPKIN_STYLE_ID=

# Cordia Assistant, served at /assistant
ASSISTANT_URL=

# Feature switches
NEXT_PUBLIC_EXTRA_CONNECTORS=
NEXT_PUBLIC_GAMES=
NEXT_PUBLIC_APP_VERSION=

# MCP server (/mcp) and the consent page (/oauth/consent). All optional; the defaults are shown.
# Must match the audience the access-token hook writes (supabase/migrations/20261031120000_oauth_lockdown.sql).
MCP_TOKEN_AUDIENCE=https://classroom.cordiacode.com/mcp
# Browser origins allowed to call /mcp (hostnames). Preview deploys also allow localhost.
MCP_ALLOWED_ORIGINS=claude.ai,chatgpt.com
# Hosts a connected app may send the student back to after the consent page. Preview deploys
# also allow localhost (MCP Inspector); production never does.
NEXT_PUBLIC_OAUTH_REDIRECT_HOSTS=claude.ai,chatgpt.com
